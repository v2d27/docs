---
/**
 * Catch-all route, shared across every registered blog (src/lib/blogs.ts).
 * Mirrors src/pages/[...slug].astro (the primary docs route) exactly —
 * each blog is a full docs-shaped tree (sidebar, TOC, prev/next, nested
 * pages), just mounted at its own `/<slug>/` prefix instead of root.
 * `getStaticPaths` fans out across every blog collection instead of
 * hardcoding one, so adding a blog needs no new route file.
 *
 * An entry with id `index` mounts at the blog's own root (`/<slug>/`),
 * same convention as the primary docs' `.md` alternate route uses for
 * the site root — Astro's rest param treats `undefined` as "no segment".
 */
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import {
  getCollectionPageProps,
  getRouteFlags,
  getSidebar,
  getPrevNext,
  getBreadcrumbs,
  getEditUrl,
  getLastUpdated,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { components } from "../../components";
import { BLOGS, type BlogSlug } from "../../lib/blogs";

export const prerender = true;

export async function getStaticPaths() {
  const lists = await Promise.all(
    BLOGS.map((blog) =>
      getCollection(blog.slug, (entry) => (import.meta.env.PROD ? !entry.data.draft : true)),
    ),
  );
  return lists.flat().map((entry) => ({
    params: { blog: entry.collection, slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry, Content, headings } = await getCollectionPageProps<BlogSlug>(Astro);

const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

const sidebar = sidebarOn
  ? await getSidebar(currentSlug, { collection: entry.collection })
  : false;
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? await getLastUpdated(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownPath =
  entry.id === "index"
    ? `/${entry.collection}/index.md`
    : `/${entry.collection}/${entry.id}/index.md`;
const markdownUrl = Astro.site ? new URL(markdownPath, Astro.site).href : markdownPath;
const socialImage = entry.data.socialImage ?? `/og/${entry.collection}/${entry.id}.png`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>
